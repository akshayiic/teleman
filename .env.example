# Copy to .env.local and fill in. Get a key from https://build.nvidia.com/nvidia/audio2face-3d
NVIDIA_API_KEY=nvapi-...

# Optional: Audio2Face-3D model (default Mark).
# Mark   8efc55f5-6f00-424e-afe9-26212cd2c630
# Claire 0961a6da-fb9e-4f2e-8491-247e5fd7bf8d
# James  9327c39f-a361-4e02-bd72-e11b4c9b7b5e
# A2F_FUNCTION_ID=8efc55f5-6f00-424e-afe9-26212cd2c630

# Optional: PEM file of a corporate HTTPS-inspection root CA (e.g. Sophos) if
# requests fail with "unable to verify the first certificate".
# A2F_CA_CERT=C:\path\to\sophos-root-ca.pem

# Tavus (real-human video). Get a key at https://maker.tavus.io/dev/api-keys
TAVUS_API_KEY=
# Echo-mode PAL used for live reading (POST /v2/pals with pipeline_mode "echo").
TAVUS_ECHO_PAL_ID=

# AVTR-1 on a GPU machine ("Priti HD"), see liteavatar-server/README.md. URL of
# avtr1_bridge.py running there, e.g. a devtunnel: https://abc123-8770.inc1.devtunnels.ms
AVTR1_URL=
# Avatar id on the AVTR-1 side = PNG file name (without .png) in its reference_frames folder.
# AVTR1_AVATAR=priya

# Optional: V-Retail conference backend the call panel joins (default below).
# NEXT_PUBLIC_VCONF_SERVER=https://backend-1.conference.svc.inkincaps.com
