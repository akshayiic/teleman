+def _drive_pose(portrait_path: Path, kp_info: KPInfo) -> KPInfo | None:
+    """Optional ``<stem>.pose.json`` next to the portrait, e.g. ``{"roll": 0, "expression": 0.6}``:
+    ``pitch``/``yaw``/``roll`` replace the portrait's head angles (degrees; 0 = facing the
+    camera, upright), ``expression`` scales its expression (1 = as photographed, 0 = neutral).
+    """
+    path = Path(portrait_path).parent / f"{Path(portrait_path).stem}.pose.json"
+    if not path.is_file():
+        return None
+    cfg = json.loads(path.read_text())
+    angles = {
+        k: torch.full_like(getattr(kp_info, k), float(cfg[k])) if k in cfg else getattr(kp_info, k)
+        for k in ("pitch", "yaw", "roll")
+    }
+    print(
+        f"{path.name}: pitch/yaw/roll {[round(float(getattr(kp_info, k)), 1) for k in angles]} -> "
+        f"{[round(float(v), 1) for v in angles.values()]}, expression x{cfg.get('expression', 1.0)}",
+        flush=True,
+    )
+    return replace(
+        kp_info,
+        **angles,
+        R=_get_rotation_matrix(angles["pitch"], angles["yaw"], angles["roll"]),
+        exp=kp_info.exp * float(cfg.get("expression", 1.0)),
+    )
+
